{
  "autoMemoryEnabled": false,
  "disableArtifact": true,
  "disableBundledSkills": true,
  "disableClaudeAiConnectors": true,
  "disableRemoteControl": true,
  "disableWorkflows": true,
  "effortLevel": "low",
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8787",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.claude/hooks/mdformat-on-edit.sh\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "rtk hook claude",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "[ -f \"$HOME/.claude/hooks/herdr-agent-state.sh\" ] && bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "gh-axi",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "chrome-devtools-axi",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "bash '/home/2456bru/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "language": "fr",
  "model": "sonnet",
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "NotebookEdit",
      "AskUserQuestion",
      "CronCreate",
      "CronDelete",
      "CronList",
      "ScheduleWakeup",
      "EnterPlanMode",
      "ExitPlanMode",
      "SendMessage",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "DesignSync"
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "bash ~/.claude/statusline-command.sh",
    "type": "command"
  },
  "theme": "auto",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "voiceEnabled": true
}