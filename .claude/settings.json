{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./rebuild.sh",
            "if": "Bash(git push *)",
            "timeout": 600,
            "statusMessage": "Rebuild home-manager (rebuild.sh) après push..."
          }
        ]
      }
    ]
  }
}
